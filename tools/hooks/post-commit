#!/bin/sh
# Learning OS v3 — post-commit refresh (canonical copy: tools/hooks/post-commit).
#
# Rebuilds generated/ after every commit so the local dashboards
# (coordination-view, indexes, concept map) are never stale. Never blocks:
# post-commit hooks cannot fail a commit, and this one only prints on trouble.
#
# Install (once per clone):
#   cp tools/hooks/post-commit .git/hooks/post-commit && chmod +x .git/hooks/post-commit

cd "$(git rev-parse --show-toplevel)" || exit 0

INSTALLED_HOOK="$(git rev-parse --git-path hooks/post-commit)"
if [ -f "$INSTALLED_HOOK" ] && ! cmp -s "$INSTALLED_HOOK" tools/hooks/post-commit; then
    echo "post-commit: installed hook is stale — run 'make hooks' before the next commit." >&2
fi

# Canonical writes (via GatewayEnvelopeV2) and `los session-end` already
# publish generated/ under the operator lock; running an extra rebuild inside
# post-commit races manual `make views` / `tools/generate.py` or deadlocks
# `session-end` when `git commit` runs under its lock (D-08 / D-17).
# Run `.venv/bin/python tools/generate.py` explicitly after manual hand edits.
exit 0
