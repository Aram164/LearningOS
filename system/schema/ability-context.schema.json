{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learningos.local/schema/ability-context-v1",
  "title": "Ability context response",
  "x-governs": "artifact",
  "type": "object",
  "required": ["schema_version", "snapshot_id", "contract"],
  "properties": {
    "schema_version": {"const": 1},
    "snapshot_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "contract": {"const": "ability-context-v1"},
    "abilities": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/abilityRow"}},
    "ability": {"$ref": "#/$defs/abilityRow"},
    "bridges": {"type": "array"},
    "candidate_connections": {"type": "array", "maxItems": 20},
    "candidate_connection_count": {"type": "integer", "minimum": 0},
    "focus": {"type": "string"},
    "state": {"type": "string"},
    "reason": {"type": "string"},
    "known_identity": {"type": "boolean"},
    "suggestions": {"type": "array", "items": {"type": "string"}, "maxItems": 5},
    "total": {"type": "integer", "minimum": 0},
    "offset": {"type": "integer", "minimum": 0},
    "returned": {"type": "integer", "minimum": 0},
    "next_offset": {"type": ["integer", "null"], "minimum": 0},
    "has_more": {"type": "boolean"},
    "truncated": {"type": "boolean"},
    "brief": {"type": "boolean"},
    "section": {"type": "string"},
    "observations": {"type": "array", "maxItems": 50},
    "ability_sha256": {"type": "string"},
    "evidence_summary": {
      "type": "object",
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "active": {"type": "integer", "minimum": 0},
        "superseded": {"type": "integer", "minimum": 0},
        "comparable": {"type": "integer", "minimum": 0},
        "valid": {"type": "integer", "minimum": 0},
        "state_basis": {"type": "array", "maxItems": 21},
        "later_conflicts_total": {"type": "integer", "minimum": 0},
        "later_conflicts_returned": {"type": "integer", "minimum": 0},
        "later_conflicts_truncated": {"type": "boolean"},
        "corrections": {"type": "array", "maxItems": 20},
        "corrections_total": {"type": "integer", "minimum": 0},
        "corrections_returned": {"type": "integer", "minimum": 0},
        "corrections_truncated": {"type": "boolean"}
      }
    },
    "encounters": {"type": "array"},
    "encounters_total": {"type": "integer", "minimum": 0},
    "encounters_truncated": {"type": "boolean"},
    "related_encounters": {"type": "array"},
    "related_encounters_total": {"type": "integer", "minimum": 0},
    "shared_concept_candidates": {"type": "array"},
    "shared_concept_candidate_count": {"type": "integer", "minimum": 0},
    "shared_concept_candidates_truncated": {"type": "boolean"},
    "expand": {},
    "expansions": {"type": "object"},
    "schema": {}
  },
  "$defs": {
    "abilityRow": {
      "type": "object",
      "properties": {
        "reasons": {"type": "array", "items": {"type": "string"}},
        "reason_codes": {
          "description": "Stable codes parallel to reasons. Consumers decide from these codes, never the prose. Optional for responses from older Cores.",
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}
        }
      }
    }
  }
}
