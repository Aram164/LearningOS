{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learningos.local/schema/candidate-source-comparison.schema.json",
  "title": "Approved prospective source comparison",
  "x-governs": "record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "type", "candidate_module_id", "status", "basis", "source_assessments", "comparisons"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^candidate-comparison-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "type": {"const": "candidate-source-comparison"},
    "candidate_module_id": {"type": "string", "pattern": "^candidate-module-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "status": {"const": "approved"},
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_revision", "candidate_set_checksum", "policy", "request_id", "delivery_id"],
      "properties": {
        "catalog_revision": {"type": "integer", "minimum": 0},
        "candidate_set_checksum": {"$ref": "https://learningos.local/schema/material-comparison-defs.schema.json#/$defs/sha256"},
        "policy": {"const": "tiered-v1"},
        "request_id": {"type": "string", "minLength": 1},
        "delivery_id": {"type": "string", "minLength": 1}
      }
    },
    "source_assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_source_id", "role", "review_status", "concept_ids"],
        "properties": {
          "candidate_source_id": {"type": "string", "pattern": "^candidate-source-[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "role": {"enum": ["selected", "current", "prerequisite", "comparison"]},
          "review_status": {"$ref": "https://learningos.local/schema/material-comparison-defs.schema.json#/$defs/routeReviewStatus"},
          "concept_ids": {"$ref": "https://learningos.local/schema/material-comparison-defs.schema.json#/$defs/conceptIds"},
          "contribution": {"type": "string", "minLength": 1},
          "assumptions": {"type": "string", "minLength": 1},
          "notation": {"type": "string", "minLength": 1},
          "exercise_value": {"type": "string", "minLength": 1},
          "best_for": {"type": "string", "minLength": 1},
          "limitations": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"$ref": "https://learningos.local/schema/material-comparison-defs.schema.json#/$defs/evidence"}}
        },
        "allOf": [{
          "if": {"properties": {"review_status": {"const": "deep-reviewed"}}, "required": ["review_status"]},
          "then": {"required": ["contribution", "assumptions", "notation", "exercise_value", "best_for", "limitations", "evidence"], "properties": {"evidence": {"minItems": 1}}},
          "else": {"required": ["reason"], "not": {"anyOf": [{"required": ["contribution"]}, {"required": ["assumptions"]}, {"required": ["notation"]}, {"required": ["exercise_value"]}, {"required": ["best_for"]}, {"required": ["limitations"]}]}}
        }]
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["left_candidate_source_id", "right_candidate_source_id", "relation", "narrative", "concept_ids", "evidence"],
        "properties": {
          "left_candidate_source_id": {"type": "string", "pattern": "^candidate-source-[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "right_candidate_source_id": {"type": "string", "pattern": "^candidate-source-[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "relation": {"$ref": "https://learningos.local/schema/material-comparison-defs.schema.json#/$defs/comparisonRelation"},
          "narrative": {"type": "string", "minLength": 1},
          "concept_ids": {
            "allOf": [
              {"$ref": "https://learningos.local/schema/material-comparison-defs.schema.json#/$defs/conceptIds"},
              {"minItems": 1}
            ]
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["left", "right"],
            "properties": {
              "left": {
                "type": "array",
                "minItems": 1,
                "items": {"$ref": "https://learningos.local/schema/material-comparison-defs.schema.json#/$defs/evidence"}
              },
              "right": {
                "type": "array",
                "minItems": 1,
                "items": {"$ref": "https://learningos.local/schema/material-comparison-defs.schema.json#/$defs/evidence"}
              }
            }
          }
        }
      }
    }
  }
}
