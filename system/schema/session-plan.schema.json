{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learningos.local/schema/session-plan.schema.json",
  "x-governs": "artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_requirement_id",
    "current_status",
    "steps",
    "rejected_alternatives",
    "assumptions",
    "replan_conditions",
    "source_stage",
    "evidence_ids",
    "evidence_conditions",
    "evidence_spec",
    "plan_status",
    "blockers",
    "requirement_sha256"
  ],
  "properties": {
    "target_requirement_id": {
      "type": "string"
    },
    "current_status": {
      "enum": [
        "unseen",
        "uncertain",
        "fragile",
        "demonstrated"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_id",
          "role",
          "reason",
          "intent"
        ],
        "properties": {
          "resource_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "intent": {
            "enum": [
              "intervention",
              "evidence"
            ]
          }
        }
      }
    },
    "rejected_alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_id",
          "reason"
        ],
        "properties": {
          "resource_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "replan_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "unit_id",
        "stage_id"
      ],
      "properties": {
        "module_id": {
          "type": "string"
        },
        "unit_id": {
          "type": "string"
        },
        "stage_id": {
          "type": "string"
        }
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_spec": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "plan_status": {
      "enum": [
        "ready",
        "blocked",
        "satisfied"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "replan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "reason"
      ],
      "properties": {
        "action": {
          "enum": [
            "none",
            "local",
            "session"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "requirement_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
