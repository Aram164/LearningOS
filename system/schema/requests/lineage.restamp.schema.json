{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learningos/requests/lineage.restamp",
  "x-governs": "artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "exact reviewed claim ids to stamp (1 or more)",
      "x-los-cli": {
        "flags": [
          "--claim-ids"
        ],
        "position": null,
        "action": "store",
        "nargs": "+",
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": "CLAIM_ID",
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      }
    },
    "claims_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 binding the exact reviewed claim list (sorted ids, one per line)",
      "x-los-cli": {
        "flags": [
          "--claims-sha256"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": "sha256_value",
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      },
      "x-los-id-kind": "digest",
      "x-los-lookup": false
    },
    "check": {
      "type": "boolean",
      "description": "recompute eligibility (all claims), or verify the plan for --claim-ids; write nothing",
      "x-los-cli": {
        "flags": [
          "--check"
        ],
        "position": null,
        "action": "store_true",
        "nargs": 0,
        "const": true,
        "default": false,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      }
    },
    "expected_snapshot": {
      "type": "string",
      "description": "Require the current canonical snapshot to equal this snapshot before restamping.",
      "x-los-cli": {
        "flags": [
          "--expected-snapshot"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": true
      }
    },
    "expected_revision": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "artifact-level concurrency token <artifact-id>=<revision>; repeatable",
      "x-los-cli": {
        "flags": [
          "--expected-revision"
        ],
        "position": null,
        "action": "append",
        "nargs": null,
        "const": null,
        "default": [],
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": true
      }
    },
    "review_report": {
      "type": "string",
      "description": "saved --check JSON; required for reviewed apply and exact retries",
      "x-los-cli": {
        "flags": [
          "--review-report"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": true,
        "transport_only": false,
        "envelope_owned": true
      }
    },
    "json": {
      "type": "boolean",
      "description": "no-op: this command always prints JSON",
      "x-los-cli": {
        "flags": [
          "--json"
        ],
        "position": null,
        "action": "store_true",
        "nargs": 0,
        "const": true,
        "default": false,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": true,
        "envelope_owned": false
      }
    }
  },
  "x-los-cli-command": {
    "name": "lineage-restamp",
    "help": "narrow judged lineage reads to per-route digests",
    "description": null,
    "epilog": null,
    "mutually_exclusive": [],
    "defaults": {},
    "handler": "learning_os.adapters.cli.invoke:lineage.restamp",
    "parser_factory": true
  }
}
