{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learningos/requests/review.apply",
  "x-governs": "artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selected",
    "unit_id"
  ],
  "properties": {
    "unit_id": {
      "type": "string",
      "description": "ID of the unit whose shelving proposal is applied",
      "x-los-cli": {
        "flags": [],
        "position": 0,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": true,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      },
      "x-los-id-kind": "unit",
      "x-los-lookup": true
    },
    "selected": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "proposal IDs to apply, where every ID must exist in the current proposal",
      "x-los-cli": {
        "flags": [
          "--selected"
        ],
        "position": null,
        "action": "store",
        "nargs": "+",
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": true,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      }
    },
    "approve": {
      "type": "boolean",
      "description": "approval flag that must be true before any selected proposal ID is applied",
      "x-los-cli": {
        "flags": [
          "--approve"
        ],
        "position": null,
        "action": "store_true",
        "nargs": 0,
        "const": true,
        "default": false,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": true
      }
    },
    "expected_snapshot": {
      "type": "string",
      "description": "optimistic concurrency token from manifest _generated.snapshot_id",
      "x-los-cli": {
        "flags": [
          "--expected-snapshot"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": true
      }
    },
    "expected_revision": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "artifact-level concurrency token <artifact-id>=<revision>; repeatable",
      "x-los-cli": {
        "flags": [
          "--expected-revision"
        ],
        "position": null,
        "action": "append",
        "nargs": null,
        "const": null,
        "default": [],
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": true
      }
    },
    "json": {
      "type": "boolean",
      "description": "no-op: this command always prints JSON",
      "x-los-cli": {
        "flags": [
          "--json"
        ],
        "position": null,
        "action": "store_true",
        "nargs": 0,
        "const": true,
        "default": false,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": true,
        "envelope_owned": false
      }
    }
  },
  "x-los-cli-command": {
    "name": "shelving-apply",
    "help": "apply only explicitly approved proposal IDs",
    "description": null,
    "epilog": null,
    "mutually_exclusive": [],
    "defaults": {},
    "handler": "learning_os.adapters.cli.invoke:review.apply",
    "parser_factory": false
  }
}
