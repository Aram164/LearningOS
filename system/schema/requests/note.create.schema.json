{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learningos/requests/note.create",
  "x-governs": "artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "body_file",
    "note"
  ],
  "properties": {
    "body_file": {
      "type": "string",
      "description": "file carrying the exact note body bytes (bound by --body-file-sha256)",
      "x-los-cli": {
        "flags": [
          "--body-file"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": true,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      }
    },
    "body_file_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 of the exact note bytes approved for creation",
      "x-los-cli": {
        "flags": [
          "--body-file-sha256"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": "sha256_value",
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      },
      "x-los-id-kind": "digest",
      "x-los-lookup": false
    },
    "expected_revision": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "artifact-level concurrency token <artifact-id>=<revision>; repeatable",
      "x-los-cli": {
        "flags": [
          "--expected-revision"
        ],
        "position": null,
        "action": "append",
        "nargs": null,
        "const": null,
        "default": [],
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": true
      }
    },
    "expected_snapshot": {
      "type": "string",
      "description": "expected_snapshot (no description in the parser yet)",
      "x-los-cli": {
        "flags": [
          "--expected-snapshot"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": true
      }
    },
    "note": {
      "type": "object",
      "description": "note (no description in the parser yet)",
      "x-los-cli": {
        "flags": [
          "--note"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": "json_object",
        "choices": null,
        "metavar": null,
        "required": true,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      }
    }
  },
  "x-los-cli-command": {
    "name": "note-create",
    "help": "create one durable note from approved bytes",
    "description": null,
    "epilog": null,
    "mutually_exclusive": [],
    "defaults": {},
    "handler": "learning_os.commands.note.cmd_note_create",
    "parser_factory": false
  }
}
