{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learningos/requests/projection.observe",
  "x-governs": "artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "confirmation"
  ],
  "properties": {
    "json": {
      "type": "boolean",
      "description": "no-op: this command always prints JSON",
      "x-los-cli": {
        "flags": [
          "--json"
        ],
        "position": null,
        "action": "store_true",
        "nargs": 0,
        "const": true,
        "default": false,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": true,
        "envelope_owned": false
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_path",
        "snapshot_after"
      ],
      "properties": {
        "receipt_path": {
          "type": "string",
          "description": "Historical committed receipt inside the selected data root."
        },
        "snapshot_after": {
          "type": "string",
          "description": "Snapshot bound to the historical committed receipt."
        }
      },
      "description": "The exact receipt and snapshot from the confirmed write.",
      "x-los-cli": {
        "flags": [
          "--confirmation"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": "json_object",
        "choices": null,
        "metavar": "JSON",
        "required": true,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      }
    }
  },
  "x-los-cli-command": {
    "name": "projection-observe",
    "help": "verify receipt completion and currency of the published projection",
    "description": null,
    "epilog": null,
    "mutually_exclusive": [],
    "defaults": {},
    "handler": "learning_os.adapters.cli.invoke:projection.observe",
    "parser_factory": false
  }
}
