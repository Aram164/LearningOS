  "x-los-cli-command": {
    "name": "unit-map-import",
    "help": "create/import the single current study map for a unit",
    "description": null,
    "epilog": null,
    "mutually_exclusive": [],
    "defaults": {},
    "handler": "learning_os.adapters.cli.invoke:unit.map.import",
    "parser_factory": false
  }
