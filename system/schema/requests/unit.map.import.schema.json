      "description": "acknowledge one stage this revision removes (repeatable)",
      "x-los-cli": {
        "flags": [
          "--retire-stage"
        ],
        "position": null,
        "action": "append",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": "STAGE_ID",
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      }
    },
    "retire_reason": {
      "type": "string",
      "description": "reviewed disposition for the evidence of every retired stage",
      "x-los-cli": {
        "flags": [
          "--retire-reason"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": "REASON",
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      }
    },
    "expected_snapshot": {
      "type": "string",
      "description": "expected_snapshot (no description in the parser yet)",
      "x-los-cli": {
        "flags": [
          "--expected-snapshot"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": true
      }
    },
    "expected_revision": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "artifact-level concurrency token <artifact-id>=<revision>; repeatable",
      "x-los-cli": {
        "flags": [
          "--expected-revision"
        ],
        "position": null,
        "action": "append",
        "nargs": null,
        "const": null,
        "default": [],
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": true
      }
