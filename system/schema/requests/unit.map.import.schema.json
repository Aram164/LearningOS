      "x-los-cli": {
        "flags": [
          "--intentional-state-reset"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": "REASON",
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      }
    },
    "retire_stage": {
      "type": "array",
      "items": {
