{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learningos/requests/unit.map.import",
  "x-governs": "artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "file",
    "unit_id"
  ],
  "properties": {
    "unit_id": {
      "type": "string",
      "description": "unit_id (no description in the parser yet)",
      "x-los-cli": {
        "flags": [],
        "position": 0,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": true,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      },
      "x-los-id-kind": "unit",
      "x-los-lookup": true
    },
    "file": {
      "type": "string",
      "description": "reviewed study-map YAML file for this unit (bytes bound by --file-sha256)",
      "x-los-cli": {
        "flags": [
          "--file"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": true,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      }
    },
    "file_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 of the exact study-map file bytes approved for import",
      "x-los-cli": {
        "flags": [
          "--file-sha256"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": "sha256_value",
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      },
      "x-los-id-kind": "digest",
      "x-los-lookup": false
    },
    "replace": {
      "type": "boolean",
      "description": "replace the unit's current study map (learner state is carried forward); required when one exists",
      "x-los-cli": {
        "flags": [
          "--replace"
        ],
        "position": null,
        "action": "store_true",
        "nargs": 0,
        "const": true,
        "default": false,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      }
    },
    "check": {
      "type": "boolean",
      "description": "print the concrete replacement diff and write nothing",
      "x-los-cli": {
        "flags": [
          "--check"
        ],
        "position": null,
        "action": "store_true",
        "nargs": 0,
        "const": true,
        "default": false,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      }
    },
    "intentional_reorder": {
      "type": "string",
      "description": "reviewed reason for changing the relative order of surviving stages",
      "x-los-cli": {
        "flags": [
          "--intentional-reorder"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": "REASON",
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      }
    },
    "intentional_state_reset": {
      "type": "string",
