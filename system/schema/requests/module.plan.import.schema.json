      "type": "boolean",
      "description": "no-op: this command always prints JSON",
      "x-los-cli": {
        "flags": [
          "--json"
        ],
        "position": null,
        "action": "store_true",
        "nargs": 0,
        "const": true,
        "default": false,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": true,
        "envelope_owned": false
      }
    }
