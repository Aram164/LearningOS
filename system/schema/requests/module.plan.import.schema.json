      "x-los-cli": {
        "flags": [
          "--approve"
        ],
        "position": null,
        "action": "store_true",
        "nargs": 0,
        "const": true,
        "default": false,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": true
