        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": "json_object",
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      }
    },
