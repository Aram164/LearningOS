      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "apply the exact reviewed file bytes through GatewayEnvelopeV2 without hand-assembling an envelope",
      "x-los-cli": {
        "flags": [
          "--apply-reviewed-sha256"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": "sha256_value",
        "choices": null,
