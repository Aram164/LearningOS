        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      },
      "x-los-id-kind": "digest",
      "x-los-lookup": false
