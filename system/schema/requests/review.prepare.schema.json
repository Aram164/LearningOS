{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learningos/requests/review.prepare",
  "x-governs": "artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unit_id"
  ],
  "properties": {
    "unit_id": {
      "type": "string",
      "description": "ID of the unit whose review packet is prepared",
      "x-los-cli": {
        "flags": [],
        "position": 0,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": true,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      },
      "x-los-id-kind": "unit",
      "x-los-lookup": true
    },
    "items_file": {
      "type": "string",
      "description": "optional JSON proposal items produced with explicit unit context",
      "x-los-cli": {
        "flags": [
          "--items-file"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      }
    },
    "items_file_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 of the exact shelving-items file bytes approved for review",
      "x-los-cli": {
        "flags": [
          "--items-file-sha256"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": "sha256_value",
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      },
      "x-los-id-kind": "digest",
      "x-los-lookup": false
    },
    "summary": {
      "type": "string",
      "description": "optional summary recorded on the shelving proposal, defaulting to the stock review line when omitted",
      "x-los-cli": {
        "flags": [
          "--summary"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      }
    },
    "expected_snapshot": {
      "type": "string",
      "description": "optimistic concurrency token from manifest _generated.snapshot_id",
      "x-los-cli": {
        "flags": [
          "--expected-snapshot"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": true
      }
    },
    "expected_revision": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "artifact-level concurrency token <artifact-id>=<revision>; repeatable",
      "x-los-cli": {
        "flags": [
          "--expected-revision"
        ],
        "position": null,
        "action": "append",
        "nargs": null,
        "const": null,
        "default": [],
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": true
      }
    },
    "json": {
      "type": "boolean",
      "description": "no-op: this command always prints JSON",
      "x-los-cli": {
        "flags": [
          "--json"
        ],
        "position": null,
        "action": "store_true",
        "nargs": 0,
        "const": true,
        "default": false,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": true,
        "envelope_owned": false
      }
    }
  },
  "x-los-cli-command": {
    "name": "shelving-prepare",
    "help": "prepare a review packet; never applies canonical changes",
    "description": null,
    "epilog": null,
    "mutually_exclusive": [],
    "defaults": {},
    "handler": "learning_os.adapters.cli.invoke:review.prepare",
    "parser_factory": false
  }
}
