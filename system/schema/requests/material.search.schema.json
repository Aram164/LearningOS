        "flags": [
          "--limit"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": 10,
        "type": "int",
        "choices": null,
        "metavar": "N",
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      }
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200,
