      "x-los-cli": {
        "flags": [
          "--offset"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": 0,
        "type": "int",
        "choices": null,
        "metavar": "N",
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
