{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learningos/requests/path.attachment.add",
  "x-governs": "artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "file",
    "path_id",
    "stage_id"
  ],
  "properties": {
    "path_id": {
      "type": "string",
      "description": "learning path whose stage gains the attachment",
      "x-los-cli": {
        "flags": [],
        "position": 0,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": true,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      },
      "x-los-id-kind": "path",
      "x-los-lookup": true
    },
    "stage_id": {
      "type": "string",
      "description": "stage of the learning path the file attaches to",
      "x-los-cli": {
        "flags": [],
        "position": 1,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": true,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      },
      "x-los-id-kind": "stage",
      "x-los-lookup": true
    },
    "file": {
      "type": "string",
      "description": "local file to attach inside the path stage (bytes bound by --file-sha256)",
      "x-los-cli": {
        "flags": [
          "--file"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": true,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      }
    },
    "file_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 of the exact attachment bytes approved for this request",
      "x-los-cli": {
        "flags": [
          "--file-sha256"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": "sha256_value",
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      },
      "x-los-id-kind": "digest",
      "x-los-lookup": false
    },
    "label": {
      "type": "string",
      "description": "optional attachment label; the file name stem when omitted",
      "x-los-cli": {
        "flags": [
          "--label"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      }
    },
    "expected_snapshot": {
      "type": "string",
      "description": "optimistic concurrency token from manifest _generated.snapshot_id",
      "x-los-cli": {
        "flags": [
          "--expected-snapshot"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": true
      }
    },
    "expected_revision": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "artifact-level concurrency token <artifact-id>=<revision>; repeatable",
      "x-los-cli": {
        "flags": [
          "--expected-revision"
        ],
        "position": null,
        "action": "append",
        "nargs": null,
        "const": null,
        "default": [],
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": true
      }
    },
    "json": {
      "type": "boolean",
      "description": "no-op: this command always prints JSON",
      "x-los-cli": {
        "flags": [
          "--json"
        ],
        "position": null,
        "action": "store_true",
        "nargs": 0,
        "const": true,
        "default": false,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": true,
        "envelope_owned": false
      }
    }
  },
  "x-los-cli-command": {
    "name": "path-attach",
    "help": "copy handwriting/media into a stage-owned attachment folder",
    "description": null,
    "epilog": null,
    "mutually_exclusive": [],
    "defaults": {},
    "handler": "learning_os.adapters.cli.invoke:path.attachment.add",
    "parser_factory": false
  }
}
