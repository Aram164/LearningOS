{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learningos/requests/plan.template",
  "x-governs": "artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "title"
  ],
  "properties": {
    "profile": {
      "type": "string",
      "enum": [
        "curriculum"
      ],
      "description": "template profile selecting the build schema; curriculum is the only profile",
      "x-los-cli": {
        "flags": [],
        "position": 0,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": [
          "curriculum"
        ],
        "metavar": null,
        "required": true,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      }
    },
    "title": {
      "type": "string",
      "description": "working title stamped into the new map's first stage; blank titles refuse",
      "x-los-cli": {
        "flags": [
          "--title"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": true,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      }
    },
    "unit_id": {
      "type": "string",
      "description": "unit id stamped into the new study map; the curriculum profile requires it",
      "x-los-cli": {
        "flags": [
          "--unit-id"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      },
      "x-los-id-kind": "unit",
      "x-los-lookup": false
    },
    "module_id": {
      "type": "string",
      "description": "module id stamped into the new map's stage note paths; the curriculum profile requires it",
      "x-los-cli": {
        "flags": [
          "--module-id"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      },
      "x-los-id-kind": "module",
      "x-los-lookup": false
    },
    "json": {
      "type": "boolean",
      "description": "answer the plan-template-v1 query envelope instead of YAML (used by the interface)",
      "x-los-cli": {
        "flags": [
          "--json"
        ],
        "position": null,
        "action": "store_true",
        "nargs": 0,
        "const": true,
        "default": false,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": true,
        "envelope_owned": false
      }
    }
  },
  "x-los-cli-command": {
    "name": "plan-template",
    "help": "print the one canonical authored-plan template for a domain profile",
    "description": null,
    "epilog": null,
    "mutually_exclusive": [],
    "defaults": {},
    "handler": "learning_os.adapters.cli.invoke:plan.template",
    "parser_factory": false
  }
}
