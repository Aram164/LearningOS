        "flags": [],
        "position": 1,
        "action": "store",
        "nargs": "*",
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      }
