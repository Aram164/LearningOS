{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learningos/requests/source.intake.record",
  "x-governs": "artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "file": {
      "type": "string",
      "description": "intake records as a YAML file",
      "x-los-cli": {
        "flags": [
          "--file"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": true,
        "transport_only": false,
        "envelope_owned": false
      }
    },
    "record": {
      "type": "object",
      "description": "inline intake object carrying the records list; --file reads it from disk instead",
      "x-los-cli": {
        "flags": [
          "--record"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": "json_object",
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      }
    },
    "check": {
      "type": "boolean",
      "description": "report the field-level diff without writing",
      "x-los-cli": {
        "flags": [
          "--check"
        ],
        "position": null,
        "action": "store_true",
        "nargs": 0,
        "const": true,
        "default": false,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      }
    },
    "expected_diff_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "diff hash from a check run; apply refuses anything else",
      "x-los-cli": {
        "flags": [
          "--expected-diff-sha256"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": "sha256_value",
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": false
      },
      "x-los-id-kind": "digest",
      "x-los-lookup": false
    },
    "approve": {
      "type": "boolean",
      "description": "direct-CLI approval flag for the write; the gateway refuses it in the payload",
      "x-los-cli": {
        "flags": [
          "--approve"
        ],
        "position": null,
        "action": "store_true",
        "nargs": 0,
        "const": true,
        "default": false,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": true
      }
    },
    "expected_snapshot": {
      "type": "string",
      "description": "optimistic concurrency token from manifest _generated.snapshot_id",
      "x-los-cli": {
        "flags": [
          "--expected-snapshot"
        ],
        "position": null,
        "action": "store",
        "nargs": null,
        "const": null,
        "default": null,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": true
      }
    },
    "expected_revision": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "artifact-level concurrency token <artifact-id>=<revision>; repeatable",
      "x-los-cli": {
        "flags": [
          "--expected-revision"
        ],
        "position": null,
        "action": "append",
        "nargs": null,
        "const": null,
        "default": [],
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": false,
        "envelope_owned": true
      }
    },
    "json": {
      "type": "boolean",
      "description": "no-op: this command always prints JSON",
      "x-los-cli": {
        "flags": [
          "--json"
        ],
        "position": null,
        "action": "store_true",
        "nargs": 0,
        "const": true,
        "default": false,
        "type": null,
        "choices": null,
        "metavar": null,
        "required": false,
        "stdin": false,
        "transport_only": true,
        "envelope_owned": false
      }
    }
  },
  "x-los-cli-command": {
    "name": "source-intake",
    "help": "create a metadata-only source or correct intake-owned fields",
    "description": null,
    "epilog": null,
    "mutually_exclusive": [
      {
        "required": true,
        "dests": [
          "file",
          "record"
        ]
      }
    ],
    "defaults": {},
    "handler": "learning_os.adapters.cli.invoke:source.intake.record",
    "parser_factory": false
  }
}
