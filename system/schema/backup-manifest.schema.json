{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learningos.local/schema/backup-manifest.schema.json",
  "title": "Allowlisted LearningOS backup inventory",
  "x-governs": "artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "type", "generated_at", "roots", "entries", "aggregate_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "type": {"const": "backup-manifest"},
    "generated_at": {"type": "string", "format": "date-time"},
    "roots": {"const": ["core", "materials", "ui"]},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["root", "path", "size", "sha256"],
        "properties": {
          "root": {"enum": ["core", "materials", "ui"]},
          "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        }
      }
    },
    "materials_aliases": {
      "type": "object",
      "description": "materials/.flat alias name -> its source folder, relative to the materials root. Derived state no backup can hold as files; recorded so a restore rebuilds it exactly.",
      "additionalProperties": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
    },
    "provenance": {
      "type": "object",
      "description": "What wrote this inventory: each checkout's commit and cleanliness, and the data-format version in force. Recorded because a restore carries Core's data but not Core's code.",
      "additionalProperties": false,
      "required": ["core", "ui", "data_contract_version"],
      "properties": {
        "core": {"$ref": "#/$defs/checkout"},
        "ui": {"$ref": "#/$defs/checkout"},
        "data_contract_version": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "aggregate_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "$defs": {
    "checkout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"type": ["boolean", "null"]}
      }
    }
  }
}
