{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learningos/study-sequence",
  "x-governs": "artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "snapshot_id",
    "valid_on_date",
    "timezone",
    "lifetime",
    "canonical_files_written",
    "unit_id",
    "study_map_id",
    "canonical_current_stage",
    "durable_stage_ids",
    "omitted_stage_ids",
    "limitations",
    "stages",
    "prerequisite_edges"
  ],
  "properties": {
    "contract": {
      "const": "study-sequence-v1"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "valid_on_date": {
      "type": "string",
      "format": "date"
    },
    "timezone": {
      "const": "Europe/Berlin"
    },
    "lifetime": {
      "const": "unit-view-and-snapshot"
    },
    "canonical_files_written": {
      "const": 0
    },
    "unit_id": {
      "type": "string"
    },
    "study_map_id": {
      "type": "string"
    },
    "canonical_current_stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "durable_stage_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "omitted_stage_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "prerequisite_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prerequisite_stage_id",
          "dependent_stage_id"
        ],
        "properties": {
          "prerequisite_stage_id": {
            "type": "string"
          },
          "dependent_stage_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
