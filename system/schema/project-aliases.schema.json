{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learning-os/project-aliases.schema.json",
  "title": "Compatibility aliases for migrated projects",
  "x-governs": "record",
  "type": "object",
  "additionalProperties": false,
  "required": ["aliases"],
  "properties": {
    "aliases": {
      "type": "object",
      "propertyNames": {"pattern": "^(module|project|workstream|step|step-map|milestone|decision|relationship)-[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "additionalProperties": {"type": "string", "pattern": "^(project|module|unit|workspace)-[a-z0-9]+(?:-[a-z0-9]+)*$"}
    }
  }
}
