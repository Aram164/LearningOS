{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learning-os/learning-path.schema.json",
  "title": "Workspace-owned learning path",
  "description": "Operational ordered stages for one subtopic. A path is temporary workspace state, never canonical knowledge; shelving proposals require explicit approval before durable notes are created.",
  "type": "object",
  "required": ["id", "type", "title", "workspace_id", "area", "status", "current_stage", "created", "stages"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^path-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "type": { "const": "learning-path" },
    "title": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "pattern": "^workspace-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "area": { "enum": ["university", "personal"] },
    "module_id": { "type": "string", "pattern": "^module-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "status": { "enum": ["active", "paused", "ready-to-shelve", "complete"] },
    "current_stage": { "type": "string", "pattern": "^stage-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "created": { "type": "string", "format": "date" },
    "updated": { "type": "string", "format": "date" },
    "objective": { "type": "string", "minLength": 1 },
    "source_plan": { "type": "string", "minLength": 1 },
    "shelving": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": { "enum": ["none", "draft", "proposed", "approved"] },
        "proposal_path": { "type": "string", "pattern": "^work/active/.+\\.md$" },
        "summary": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "title", "destination", "rationale"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^proposal-[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "kind": { "enum": ["durable-note", "garden", "concept-relation", "archive-path"] },
              "title": { "type": "string", "minLength": 1 },
              "destination": { "type": "string", "minLength": 1 },
              "rationale": { "type": "string", "minLength": 1 },
              "diff": { "type": "string" },
              "selected": { "type": "boolean", "default": true }
            }
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "objective", "done_when"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^stage-[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pending", "active", "complete", "skipped"] },
          "objective": { "type": "string", "minLength": 1 },
          "estimate_minutes": { "type": "integer", "minimum": 1 },
          "exam_critical": { "type": "boolean", "default": false },
          "concepts": {
            "type": "array",
            "items": { "type": "string", "pattern": "^concept-[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "uniqueItems": true
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "label"],
              "additionalProperties": false,
              "properties": {
                "kind": { "enum": ["watch", "read", "reference", "practice"] },
                "label": { "type": "string", "minLength": 1 },
                "source_id": { "type": "string", "pattern": "^source-[a-z0-9]+(?:-[a-z0-9]+)*$" },
                "locator": { "type": "string" },
                "url": { "type": "string", "format": "uri" },
                "vault_path": { "type": "string", "minLength": 1 }
              }
            }
          },
          "done_when": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "notes_path": { "type": "string", "pattern": "^work/active/.+\\.md$" },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "label"],
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string", "pattern": "^work/active/.+" },
                "label": { "type": "string", "minLength": 1 }
              }
            }
          },
          "completed": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
