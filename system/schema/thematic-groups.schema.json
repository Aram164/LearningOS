{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learning-os/thematic-groups.schema.json",
  "title": "Thematic navigation groups",
  "x-governs": "record",
  "description": "Stable, extensible routing neighborhoods projected to interfaces. They organize Modules, Learning Sources and Topic Packs without becoming a concept ontology.",
  "type": "object",
  "required": [
    "thematic_groups"
  ],
  "additionalProperties": false,
  "properties": {
    "thematic_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "order"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^thematic-group-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
