{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learningos.local/schema/learning-plan-v1",
  "title": "LearningOS canonical plan template v1",
  "x-governs": "record",
  "description": "The shared authored-plan vocabulary for every LearningOS module.",
  "$defs": {
    "nonEmptyText": {
      "type": "string",
      "pattern": "\\S"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^resource-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "route_id": {
          "description": "Optional stable pointer to one rich material route on the owning unit. Independent resources remain valid without it.",
          "type": "string",
          "pattern": "^route-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "watch",
            "read",
            "practise",
            "reference"
          ]
        },
        "label": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "source_id": {
          "type": "string",
          "pattern": "^source-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "locator": {
          "description": "Where to start, exactly. For a book, paper or course this means the numbered chapter or section AND a page range in PDF pages (the number a viewer's page box takes, cover counted as 1) — see system/PLAN-CREATION-SOP.md. \"Chapter 9\" of a 700-page book is a direction, not a locator.",
          "type": "string"
        },
        "angle": {
          "description": "What this material does for THIS stage that the others on it do not — one line, rendered beside the label. It is a field rather than a suffix on `locator` so an interface can show it, sort by it, and check that it is there.",
          "type": "string",
          "pattern": "\\S"
        },
        "angle_detail": {
          "description": "The same judgment at length, for the hover: what the reader actually gets, what it assumes, and how it differs from the lecture's own treatment. Never a restatement of `angle`.",
          "type": "string",
          "pattern": "\\S"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "vault_path": {
          "type": "string"
        },
        "scope_triage": {
          "enum": [
            "required-now",
            "helpful-now",
            "deferred",
            "reference-only"
          ]
        },
        "affordance": {
          "description": "What the resource is a candidate for: guided work (intervention), independent target evidence (evidence), or either depending on learner state (mixed). A candidate annotation, not a suitability verdict.",
          "enum": [
            "intervention",
            "evidence",
            "mixed"
          ]
        },
        "material_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "route_id",
            "inherit"
          ],
          "properties": {
            "route_id": {
              "type": "string",
              "pattern": "^route-[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "inherit": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "label",
                  "source_id",
                  "locator",
                  "angle",
                  "angle_detail",
                  "url",
                  "vault_path"
                ]
              }
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "label"
          ]
        },
        {
          "required": [
            "material_ref"
          ],
          "properties": {
            "material_ref": {
              "properties": {
                "inherit": {
                  "contains": {
                    "const": "label"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "stageCore": {
      "type": "object",
      "required": [
        "id",
        "number",
        "title",
        "status",
        "objective",
        "done_when",
        "exam_critical",
        "concepts",
        "scope_triage",
        "resources",
        "attachments",
        "source_feedback"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^stage-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "status": {
          "enum": [
            "pending",
            "active",
            "paused",
            "complete",
            "skipped"
          ]
        },
        "objective": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "done_when": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyText"
          }
        },
        "estimate_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "exam_critical": {
          "type": "boolean"
        },
        "concepts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^concept-[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "scope_triage": {
          "enum": [
            "required-now",
            "helpful-now",
            "deferred",
            "reference-only"
          ]
        },
        "runtime_target": {
          "description": "The stage's single canonical requirement semantics. Owning stage is the only author; LearningRequirement IR is compiled from this block and nothing else.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "concept",
            "capability",
            "evidence_spec"
          ],
          "properties": {
            "concept": {
              "type": "string",
              "pattern": "^(concept|knowledge)-[a-z0-9-]+$"
            },
            "capability": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "operands"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "recognize",
                    "compute",
                    "explain",
                    "distinguish",
                    "diagnose",
                    "transfer",
                    "derive",
                    "apply",
                    "classify"
                  ]
                },
                "operands": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                }
              }
            },
            "conditions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "evidence_spec": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "attachments": {
          "type": "array"
        },
        "source_feedback": {
          "type": "array"
        }
      }
    },
    "curriculumStage": {
      "allOf": [
        {
          "$ref": "#/$defs/stageCore"
        },
        {
          "type": "object",
          "required": [
            "working_note"
          ],
          "properties": {
            "working_note": {
              "type": "string",
              "pattern": "^curriculum/modules/.+/stages/.+/notes\\.md$"
            },
            "attachments": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "label"
                ],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^curriculum/modules/.+/stages/.+/attachments/.+"
                  },
                  "label": {
                    "$ref": "#/$defs/nonEmptyText"
                  }
                }
              }
            },
            "source_feedback": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "source_id",
                  "feedback",
                  "recorded"
                ],
                "additionalProperties": false,
                "properties": {
                  "source_id": {
                    "type": "string",
                    "pattern": "^source-[a-z0-9]+(?:-[a-z0-9]+)*$"
                  },
                  "resource_id": {
                    "type": "string",
                    "pattern": "^resource-[a-z0-9]+(?:-[a-z0-9]+)*$"
                  },
                  "feedback": {
                    "enum": [
                      "helpful",
                      "too-advanced",
                      "wrong-perspective",
                      "useful-for-derivation",
                      "useful-for-review",
                      "skipped"
                    ]
                  },
                  "note": {
                    "type": "string"
                  },
                  "recorded": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            },
            "detour_id": {
              "type": "string",
              "pattern": "^detour-[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "completed": {
              "type": "string",
              "format": "date"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
