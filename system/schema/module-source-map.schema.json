{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learning-os/module-source-map.schema.json",
  "title": "Module-specific source map",
  "type": "object",
  "required": ["type", "module_id", "sources"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "module-source-map" },
    "module_id": { "type": "string", "pattern": "^module-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "role", "why", "priority"],
        "additionalProperties": false,
        "properties": {
          "source_id": { "type": "string", "pattern": "^source-[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "role": { "enum": ["course-material", "spine", "first-exposure", "intuition", "derivation", "implementation", "practice", "exam-preparation", "optional-depth", "reference", "candidate"] },
          "why": { "type": "string", "minLength": 1 },
          "when": { "type": "string" },
          "priority": { "type": "integer", "minimum": 0 },
          "unit_routes": {
            "type": "array",
            "description": "A string is the legacy routing edge. A rich route is a learner-facing material option for one unit: it explains the lecture-specific angle and coverage but does not impose an order.",
            "items": {
              "oneOf": [
                { "type": "string", "pattern": "^unit-[a-z0-9]+(?:-[a-z0-9]+)*$" },
                {
                  "type": "object",
                  "required": ["unit_id", "title", "format", "angle", "covers", "depth", "scope"],
                  "additionalProperties": false,
                  "properties": {
                    "unit_id": { "type": "string", "pattern": "^unit-[a-z0-9]+(?:-[a-z0-9]+)*$" },
                    "title": { "type": "string", "minLength": 1 },
                    "format": {
                      "enum": ["course-material", "exercise", "book", "video", "website", "course", "documentation", "code", "paper"]
                    },
                    "angle": { "type": "string", "minLength": 1 },
                    "covers": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "type": "string", "pattern": "^knowledge-[a-z0-9]+(?:-[a-z0-9]+)*$" },
                      "uniqueItems": true
                    },
                    "depth": {
                      "enum": ["orientation", "intuition", "course-aligned", "derivation", "implementation", "practice", "advanced-reference"]
                    },
                    "scope": {
                      "enum": ["current", "prerequisite", "complementary", "optional", "prior-year", "out-of-scope"]
                    },
                    "locator": { "type": "string", "minLength": 1 },
                    "url": { "type": "string", "format": "uri" },
                    "vault_path": { "type": "string", "minLength": 1 }
                  }
                }
              ]
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
