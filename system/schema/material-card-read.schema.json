{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learningos.local/schema/material-card-read-v1",
  "title": "Private reading card read response",
  "description": "Full unreviewed private reading card returned by material.card.read (ADR-021): untruncated paraphrase, complete pointer list, write provenance, and concepts checked against the repository. Never coverage evidence.",
  "x-governs": "artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "session",
    "card"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract": {
      "const": "material-card-read-v1"
    },
    "session": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card",
        "version",
        "pages",
        "material",
        "file_sha256",
        "kinds",
        "paraphrase",
        "pointers",
        "concepts",
        "dangling_concepts",
        "review",
        "coverage_evidence",
        "written"
      ],
      "properties": {
        "card": {
          "type": "string",
          "pattern": "^card-[0-9a-f]{16}-p[1-9][0-9]*-[1-9][0-9]*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "pages": {
          "type": "string",
          "minLength": 1
        },
        "material": {
          "type": "string",
          "minLength": 1
        },
        "file_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "enum": [
              "intuition",
              "visual",
              "statement",
              "derivation",
              "proof",
              "worked-example",
              "exercises",
              "solutions",
              "application",
              "overview"
            ]
          }
        },
        "paraphrase": {
          "type": "string",
          "minLength": 20,
          "maxLength": 800
        },
        "pointers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "page",
              "kind",
              "label"
            ],
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "kind": {
                "enum": [
                  "intuition",
                  "visual",
                  "statement",
                  "derivation",
                  "proof",
                  "worked-example",
                  "exercises",
                  "solutions",
                  "application",
                  "overview"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            }
          }
        },
        "concepts": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^concept-[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "dangling_concepts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^concept-[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "review": {
          "const": "unreviewed"
        },
        "coverage_evidence": {
          "const": false
        },
        "written": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session",
            "entry",
            "at"
          ],
          "properties": {
            "session": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "entry": {
              "type": "string",
              "pattern": "^rd-[0-9a-f]{16}$"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    }
  }
}
