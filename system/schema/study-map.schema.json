{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learning-os/study-map.schema.json",
  "title": "One current study script for a curriculum unit",
  "type": "object",
  "required": ["id", "type", "unit_id", "status", "current_stage", "source_plan", "stages", "shelving"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^study-map-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "type": { "const": "study-map" },
    "unit_id": { "type": "string", "pattern": "^unit-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "status": { "enum": ["not-started", "ready", "active", "paused", "ready-to-shelve", "complete"] },
    "current_stage": { "type": "string", "pattern": "^stage-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "source_plan": {
      "type": "object",
      "required": ["path", "provenance"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "provenance": { "enum": ["migrated-mini-plan", "learner", "ai-proposed", "operator", "durable-note"] }
      }
    },
    "detours": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "spawned_by_stage", "classification", "status", "return_to_stage"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^detour-[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "spawned_by_stage": { "type": "string", "pattern": "^stage-[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "classification": { "enum": ["required-now", "helpful-now", "deferred", "reference-only"] },
          "status": { "enum": ["open", "resolved", "deferred"] },
          "return_to_stage": { "type": "string", "pattern": "^stage-[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "resolution": { "type": "string" }
        }
      }
    },
    "shelving": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": { "enum": ["none", "draft", "proposed", "approved", "applied"] },
        "proposal_path": { "type": "string" },
        "summary": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "title", "destination", "rationale"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^proposal-[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "kind": { "enum": ["durable-note", "garden", "concept-relation", "archive-map"] },
              "title": { "type": "string", "minLength": 1 },
              "destination": { "type": "string", "minLength": 1 },
              "rationale": { "type": "string", "minLength": 1 },
              "diff": { "type": "string" },
              "content": { "type": "string" },
              "metadata": { "type": "object" },
              "selected": { "type": "boolean" }
            }
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "objective", "done_when", "resources", "working_note", "attachments", "source_feedback", "scope_triage"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^stage-[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pending", "active", "paused", "complete", "skipped"] },
          "objective": { "type": "string", "minLength": 1 },
          "done_when": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "estimate_minutes": { "type": "integer", "minimum": 1 },
          "exam_critical": { "type": "boolean" },
          "concepts": {
            "type": "array",
            "items": { "type": "string", "pattern": "^concept-[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "uniqueItems": true
          },
          "scope_triage": { "enum": ["required-now", "helpful-now", "deferred", "reference-only"] },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "label"],
              "additionalProperties": false,
              "properties": {
                "kind": { "enum": ["watch", "read", "practise", "reference"] },
                "label": { "type": "string", "minLength": 1 },
                "source_id": { "type": "string", "pattern": "^source-[a-z0-9]+(?:-[a-z0-9]+)*$" },
                "locator": { "type": "string" },
                "url": { "type": "string", "format": "uri" },
                "vault_path": { "type": "string" },
                "scope_triage": {
                  "description": "Priority of THIS resource within its stage, using the same vocabulary as the stage's own scope_triage. Optional: absent means unranked, which is what every pre-v2 record carries. A required-now stage can still hold a reference-only resource — that is the point. Renders as: required-now = do this; helpful-now = if you get stuck; deferred = depth, not now; reference-only = preserved, don't read it for this stage.",
                  "enum": ["required-now", "helpful-now", "deferred", "reference-only"]
                }
              }
            }
          },
          "working_note": { "type": "string", "pattern": "^curriculum/modules/.+/stages/.+/notes\\.md$" },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "label"],
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string", "pattern": "^curriculum/modules/.+/stages/.+/attachments/.+" },
                "label": { "type": "string", "minLength": 1 }
              }
            }
          },
          "source_feedback": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source_id", "feedback", "recorded"],
              "additionalProperties": false,
              "properties": {
                "source_id": { "type": "string", "pattern": "^source-[a-z0-9]+(?:-[a-z0-9]+)*$" },
                "feedback": { "enum": ["helpful", "too-advanced", "wrong-perspective", "useful-for-derivation", "useful-for-review", "skipped"] },
                "note": { "type": "string" },
                "recorded": { "type": "string", "format": "date" }
              }
            }
          },
          "detour_id": { "type": "string", "pattern": "^detour-[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "completed": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
