{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learningos.local/schema/practice-context-v1",
  "title": "Practice context response",
  "x-governs": "artifact",
  "type": "object",
  "required": [
    "schema_version", "snapshot_id", "contract", "note_id", "items"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "snapshot_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "contract": { "const": "practice-context-v1" },
    "note_id": { "type": "string" },
    "note_revision": { "type": "integer", "minimum": 0 },
    "practice_index_revision": { "type": "integer", "minimum": 0 },
    "diagnostics": { "type": "array", "items": { "type": "string" } },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "item_id", "label", "kind", "prompt", "status", "checked",
        "content_sha256", "concept_ids"
      ],
      "properties": {
        "item_id": { "type": "string" },
        "label": { "type": "string" },
        "kind": { "type": "string", "enum": ["flashcard", "worked"] },
        "prompt": { "type": "string" },
        "status": {
          "type": "string",
          "enum": [
            "unverified", "cross-checked", "source-matched", "confirmed",
            "disputed"
          ]
        },
        "checked": { "type": "boolean" },
        "ineligibility": { "type": "array", "items": { "type": "string" } },
        "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "concept_ids": { "type": "array", "items": { "type": "string" } },
        "stored_row": {
          "type": ["object", "null"],
          "description": "the exact sidecar row, for the verification gesture's expected-old guard"
        }
      }
    }
  }
}
