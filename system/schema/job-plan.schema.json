{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learningos.local/schema/job-plan-v2",
  "title": "LearningOS Job learning plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "schema_version", "plan_template_version", "id", "title", "status", "horizon", "cadence", "outcome", "stages"],
  "properties": {
    "type": {"const": "job-learning-plan"},
    "schema_version": {"const": 2},
    "plan_template_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"},
    "title": {"type": "string", "pattern": "\\S"},
    "status": {"type": "string", "pattern": "\\S"},
    "horizon": {"enum": ["now", "next", "later"]},
    "cadence": {"type": "string"},
    "outcome": {"type": "string"},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://learningos.local/schema/learning-plan-v1#/$defs/jobStage"}
    }
  }
}
