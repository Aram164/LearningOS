{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capabilities/note.create.schema.json",
  "title": "payload for capability note.create",
  "description": "Derived from the los CLI parser for this capability's named command. Do not hand-edit; regenerate with tools/generate_capability_schemas.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "body_file",
    "note"
  ],
  "properties": {
    "body_file": {
      "type": "string",
      "description": "file carrying the exact note body bytes (bound by --body-file-sha256)"
    },
    "body_file_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 of the exact note bytes approved for creation"
    },
    "note": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "concepts": {
          "type": [
            "array",
            "null"
          ]
        },
        "sources": {
          "type": [
            "array",
            "null"
          ]
        },
        "contexts": {
          "type": [
            "array",
            "null"
          ]
        },
        "supersedes": {
          "type": [
            "array",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "title"
      ],
      "description": "Accepted note input fields, a subset of the stored note record: type/created/state/authorship/semantic_review are set by the handler (the stored shape is system/schema/note.schema.json)."
    }
  },
  "dependentRequired": {
    "body_file": [
      "body_file_sha256"
    ],
    "body_file_sha256": [
      "body_file"
    ]
  }
}
