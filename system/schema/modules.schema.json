{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learning-os/modules.schema.json",
  "title": "Backward-compatible monolithic module records",
  "description": "Compatibility input for records/modules.yaml. Curriculum v2 uses partitioned curriculum/modules/<id>/module.yaml records; this contract remains loadable during migration.",
  "type": "object",
  "required": ["modules"],
  "additionalProperties": false,
  "properties": {
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^module-[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "type": { "const": "module" },
          "kind": { "enum": ["academic", "skill", "project", "foundation"] },
          "area_id": { "type": "string", "pattern": "^program-[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "institution": { "type": "string", "minLength": 1 },
          "code": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "credits": { "type": "number", "minimum": 0 },
          "semester": { "type": "string", "pattern": "^(sose|wise)-[0-9]{4}$" },
          "status": { "enum": ["planned", "enrolled", "active", "paused", "awaiting-grade", "completed", "dropped", "archived"] },
          "source_map": { "type": "string" },
          "unit_order": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "related_module_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "examination": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["klausur", "muendlich", "portfolio", "project", "hausarbeit", "other"] },
              "notes": { "type": "string" },
              "sittings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["termin", "date"],
                  "additionalProperties": false,
                  "properties": {
                    "termin": { "type": "integer", "minimum": 1, "maximum": 3 },
                    "date": { "type": "string", "format": "date" },
                    "end_date": { "type": "string", "format": "date" },
                    "time": { "type": "string", "minLength": 1 },
                    "label": { "type": "string", "minLength": 1 },
                    "notes": { "type": "string" }
                  }
                }
              },
              "registration_windows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["opens", "closes", "label"],
                  "additionalProperties": false,
                  "properties": {
                    "opens": { "type": "string", "format": "date" },
                    "closes": { "type": "string", "format": "date" },
                    "label": { "type": "string", "minLength": 1 },
                    "action": { "type": "string", "minLength": 1 },
                    "termins": {
                      "type": "array",
                      "items": { "type": "integer", "minimum": 1, "maximum": 3 },
                      "uniqueItems": true
                    }
                  }
                }
              }
            }
          },
          "components": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "object",
                  "required": ["id", "title", "order"],
                  "additionalProperties": false,
                  "properties": {
                    "id": { "type": "string" },
                    "title": { "type": "string" },
                    "short_title": { "type": "string" },
                    "order": { "type": "integer", "minimum": 0 }
                  }
                }
              ]
            }
          },
          "attempts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["termin", "result"],
              "additionalProperties": false,
              "properties": {
                "termin": { "type": "integer", "minimum": 1, "maximum": 3 },
                "date": { "type": "string", "format": "date" },
                "result": { "enum": ["registered", "withdrawn", "passed", "failed"] },
                "grade": { "type": "number", "minimum": 1.0, "maximum": 5.0 },
                "notes": { "type": "string" }
              }
            }
          },
          "grade": { "type": "number", "minimum": 1.0, "maximum": 5.0 }
        }
      }
    }
  }
}
