{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learningos/practice-index",
  "title": "Practice verification sidecar (knowledge/practice-index.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "material_relpath",
        "file_sha256",
        "page"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "material_relpath": {
          "type": "string",
          "minLength": 1
        },
        "file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "verified_at",
        "artifact_sha256",
        "reviewer_id"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "official-source",
            "independent-solve",
            "explicit-review"
          ]
        },
        "verified_at": {
          "type": "string",
          "minLength": 1
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "source_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/binding"
            },
            {
              "type": "null"
            }
          ]
        },
        "comparison_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "concept_ids",
        "kind",
        "status",
        "content_sha256",
        "source_bindings",
        "verifications"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "^[^#\\s]+#[A-Z]+[0-9]+$"
        },
        "concept_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "flashcard",
            "worked"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "unverified",
            "cross-checked",
            "source-matched",
            "confirmed",
            "disputed"
          ]
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "verifications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proof"
          }
        }
      }
    }
  },
  "x-governs": "record"
}
