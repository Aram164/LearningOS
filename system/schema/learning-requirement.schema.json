{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learningos.local/schema/learning-requirement",
  "title": "LearningRequirement",
  "description": "Represents what the learner must be able to do and what evidence is acceptable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "concept",
    "capability",
    "evidence_spec"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^req-[a-z0-9-]+$"
    },
    "concept": {
      "type": "string",
      "pattern": "^knowledge-[a-z0-9-]+$"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operands"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "operands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_spec": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "source_stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "unit_id",
        "stage_id"
      ],
      "properties": {
        "module_id": {
          "type": "string"
        },
        "unit_id": {
          "type": "string"
        },
        "stage_id": {
          "type": "string"
        }
      }
    }
  },
  "x-governs": "artifact"
}
