{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learning-os/project.schema.json",
  "title": "First-class LearningOS project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "project_type",
    "status",
    "root_uri",
    "objective",
    "milestone_ids",
    "linked_module_ids",
    "unit_ids",
    "workspace_ids",
    "thematic_group_ids",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^project-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "type": {
      "const": "project"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "project_type": {
      "enum": [
        "thesis",
        "research",
        "software",
        "writing",
        "other"
      ]
    },
    "status": {
      "enum": [
        "planned",
        "active",
        "paused",
        "completed",
        "archived"
      ]
    },
    "root_uri": {
      "type": "string",
      "pattern": "^(project|github)://[^\\s]+$"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "milestone_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^milestone-[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "linked_module_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^module-[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "unit_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^unit-[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "workspace_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^workspace-[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "thematic_group_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^thematic-group-[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidentiality",
        "external_code_access"
      ],
      "properties": {
        "confidentiality": {
          "enum": [
            "public",
            "private",
            "confidential"
          ]
        },
        "external_code_access": {
          "enum": [
            "none",
            "read-only",
            "approved"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "nodes"
      ],
      "properties": {
        "kind": {
          "enum": [
            "none",
            "linear",
            "parallel",
            "nested"
          ]
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/structureNode"
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "path"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "input",
              "output",
              "working",
              "external"
            ]
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^decision-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "decided",
              "revisit"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "decided_at": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "migrated_from": {
      "type": "string"
    },
    "migrated_at": {
      "type": "string",
      "format": "date-time"
    },
    "migration": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "structureNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(workstream|step-map|step|milestone)-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "workstream",
            "step-map",
            "step",
            "milestone"
          ]
        },
        "status": {
          "enum": [
            "planned",
            "active",
            "blocked",
            "complete",
            "completed",
            "deferred"
          ]
        },
        "summary": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/structureNode"
          }
        }
      }
    }
  }
}
