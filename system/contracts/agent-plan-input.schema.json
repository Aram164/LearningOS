{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2,
      "default": 2
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "on_error": {
      "enum": [
        "stop",
        "continue"
      ]
    },
    "read_workers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "description": "Legacy compatibility field; all accepted values execute serially with one worker."
    },
    "deadline_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "report_max_bytes": {
      "type": "integer",
      "minimum": 1024
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "kind": {
            "const": "log"
          },
          "use": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "writes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ready_timeout_s": {
            "type": "number",
            "minimum": 0
          },
          "summary": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(?!_missing_fields(?:\\.|$))[^.]+(?:\\.[^.]+)*$"
                }
              },
              "max_items": {
                "type": "integer",
                "minimum": 1
              },
              "max_bytes": {
                "type": "integer",
                "minimum": 64
              }
            }
          },
          "key": {
            "type": "string",
            "pattern": "\\S"
          },
          "text": {
            "type": "string",
            "pattern": "\\S"
          },
          "stage_id": {
            "type": "string",
            "minLength": 1
          },
          "unit_id": {
            "type": "string",
            "minLength": 1
          },
          "describe": {
            "type": "boolean"
          },
          "write": {
            "type": "boolean"
          },
          "preflight": {
            "type": "boolean"
          },
          "clusters": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "log"
                }
              }
            },
            "then": {
              "required": [
                "text",
                "key"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "use"
                    ]
                  },
                  {
                    "required": [
                      "argv"
                    ]
                  },
                  {
                    "required": [
                      "args"
                    ]
                  }
                ]
              }
            },
            "else": {
              "oneOf": [
                {
                  "required": [
                    "argv"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "use"
                        ]
                      },
                      {
                        "required": [
                          "args"
                        ]
                      }
                    ]
                  }
                },
                {
                  "required": [
                    "use"
                  ],
                  "not": {
                    "required": [
                      "argv"
                    ]
                  }
                }
              ]
            }
          },
          {
            "if": {
              "required": [
                "describe"
              ],
              "properties": {
                "describe": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "use"
              ]
            }
          },
          {
            "if": {
              "required": [
                "stage_id"
              ]
            },
            "then": {
              "required": [
                "unit_id"
              ]
            }
          }
        ]
      }
    }
  }
}
