{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Historical review-consolidation record",
  "type": "object",
  "required": [
    "schema_version",
    "recorded_revision",
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "recorded_revision": {
      "const": "d3d3b3510349f84cee2d7aca1b8601330409539d"
    },
    "findings": {
      "type": "array",
      "minItems": 42,
      "maxItems": 42,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "root_cause",
          "owner",
          "affected_callers",
          "existing_repair",
          "regression_tests",
          "disposition",
          "measured_evidence",
          "source_status",
          "owner_path",
          "caller_paths"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][0-9]{2}$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "root_cause": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "affected_callers": {
            "type": "string",
            "minLength": 1
          },
          "existing_repair": {
            "type": "string",
            "minLength": 1
          },
          "regression_tests": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "already-inherited",
              "implemented",
              "implemented-opt-in",
              "rejected-as-unsafe"
            ]
          },
          "measured_evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_status": {
            "enum": [
              "inherited-regression-covered",
              "implemented",
              "implemented-opt-in",
              "rejected-as-unsafe"
            ]
          },
          "owner_path": {
            "type": "string",
            "minLength": 1
          },
          "caller_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  }
}
