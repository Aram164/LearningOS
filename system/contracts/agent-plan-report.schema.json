{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "steps",
    "totals",
    "full_report"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "experimental": {
      "type": "boolean"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "on_error": {
      "enum": [
        "stop",
        "continue"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "commit_certainty"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "error",
              "blocked",
              "not_ready",
              "skipped",
              "deadline"
            ]
          },
          "commit_certainty": {
            "enum": [
              "none",
              "committed",
              "uncertain"
            ]
          },
          "error": {
            "type": "object"
          },
          "output": {},
          "receipt": {
            "type": "object"
          },
          "validation": {
            "type": "string"
          },
          "raw_artifact": {
            "type": "string"
          },
          "details_index": {
            "type": "integer"
          },
          "output_omitted": {
            "type": "boolean"
          },
          "receipt_in_full_report": {
            "type": "boolean"
          },
          "exit": {
            "type": "integer"
          },
          "ms": {
            "type": "integer"
          },
          "ready_wait_ms": {
            "type": "integer"
          },
          "raw_bytes": {
            "type": "integer"
          },
          "out_bytes": {
            "type": "integer"
          },
          "raw_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "totals": {
      "type": "object"
    },
    "full_report": {
      "type": [
        "string",
        "null"
      ]
    },
    "output_omitted": {
      "type": "boolean"
    },
    "artifact_error": {
      "type": "string"
    },
    "plan_sha256": {
      "type": "string"
    },
    "plan_artifact": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
