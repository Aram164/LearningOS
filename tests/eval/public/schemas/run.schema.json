{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learningos-eval/run.schema.json",
  "title": "Evaluation run record (runs/<run-id>/run.json)",
  "type": "object",
  "required": [
    "run_id",
    "plan",
    "session_role",
    "started",
    "product_revision",
    "world_head",
    "blind"
  ],
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "plan": {
      "enum": [
        "B",
        "A",
        "E",
        "X",
        "X1",
        "X2",
        "U",
        "P",
        "R",
        "C",
        "V",
        "O"
      ],
      "description": "run plan from CONSUMER-PROTOCOL.md; X1 and X2 are the two halves of X (S15-S17, S18-S22); C, V and O declare an explicit subset"
    },
    "session_role": {
      "type": "string",
      "description": "e.g. blind-consumer-novice, blind-consumer-learner, resuming-agent, abuse-investigator, scale-investigator, friction-investigator, clean-room-final"
    },
    "persona": {
      "type": "string"
    },
    "blind": {
      "type": "boolean",
      "description": "true when the session never had oracle access"
    },
    "started": {
      "type": "string",
      "format": "date-time"
    },
    "finished": {
      "type": "string",
      "format": "date-time"
    },
    "product_revision": {
      "type": "string",
      "description": "LearningOS commit installed in the world (EVAL-WORLD.json product_revision)"
    },
    "eval_revision": {
      "type": "string",
      "description": "commit of the repository holding tests/eval"
    },
    "world_head": {
      "type": "string"
    },
    "world_build": {
      "type": "object",
      "description": "copy of EVAL-WORLD.json"
    },
    "model": {
      "type": "string",
      "description": "the agent model, if known"
    },
    "environment": {
      "type": "object"
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^S[0-9]{2}$"
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "anything done differently from the protocol, and why"
    },
    "ui_revision": {
      "type": "string",
      "description": "UI commit used by the run, when it uses one (plans U, R, S22)"
    },
    "worlds": {
      "type": "array",
      "description": "every world the run built or copied",
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "world_head": {
            "type": "string"
          },
          "product_revision": {
            "type": "string"
          },
          "scale": {
            "type": "integer"
          },
          "derived_from": {
            "type": "string"
          }
        }
      }
    }
  }
}
