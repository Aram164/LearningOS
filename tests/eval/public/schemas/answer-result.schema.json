{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learningos-eval/answer-result.schema.json",
  "title": "One retrieval answer (one line of runs/<run-id>/answers.jsonl)",
  "type": "object",
  "required": ["question", "answer", "evidence"],
  "additionalProperties": false,
  "properties": {
    "question": {"type": "string", "pattern": "^Q[0-9]{2}$"},
    "answer": {"type": "string"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref"],
        "properties": {"ref": {"type": "string", "description": "record id or repository path"}, "quote": {"type": "string"}}
      }
    },
    "confidence": {"enum": ["high", "medium", "low"]},
    "commands": {"type": "array", "items": {"type": "string"}},
    "tool_calls": {"type": "integer", "minimum": 0},
    "impl_files_read": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  }
}
