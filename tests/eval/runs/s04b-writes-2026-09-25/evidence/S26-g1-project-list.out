[{"boundaries":{"confidentiality":"private","external_code_access":"none"},"decisions":[{"decided_at":"2026-08-24","id":"decision-ledgerline-pause","status":"decided","summary":"No Ledgerline work before the Statistical Learning retake and the OS oral.","title":"Pause until after the October exams"}],"id":"project-ledgerline","linked_module_ids":[],"milestone_ids":["milestone-ledgerline-design"],"objective":"A personal notes tool where every change to a note is recorded as an append-only receipt, so any past state can be reconstructed and every edit can be explained.","path":"projects/registry/project-ledgerline.yaml","project_type":"software","relationship_ids":[],"revision":0,"root_uri":"github://noor-haddad/ledgerline","schema_version":1,"status":"paused","structure":{"kind":"none","nodes":[]},"thematic_group_ids":["thematic-group-software"],"title":"Ledgerline — notes with change receipts","type":"project","unit_ids":[],"workspace_ids":["workspace-ledgerline"]},{"boundaries":{"confidentiality":"public","external_code_access":"read-only","notes":"The code lives in its own repository; LearningOS keeps the learning around it."},"decisions":[{"decided_at":"2026-08-04","id":"decision-tessera-rules-before-cost","status":"decided","summary":"Implement algebraic rewrite rules first; cost-based join ordering only after the executor is stable.","title":"Rule-based rewrites before any cost model"}],"id":"project-tessera","linked_module_ids":["module-skill-dataframes","module-tuh-dbsys"],"milestone_ids":["milestone-tessera-parser","milestone-tessera-optimizer"],"objective":"Build a small dataflow query engine in Rust to understand how logical plans are rewritten before execution: a parser for a tiny SQL subset, a logical plan tree, a rule-based optimizer, and a pull-based executor over CSV files.","path":"projects/registry/project-tessera.yaml","project_type":"software","relationship_ids":["relationship-tessera-dataframes"],"revision":0,"root_uri":"github://noor-haddad/tessera","schema_version":1,"status":"active","structure":{"kind":"linear","nodes":[{"id":"step-tessera-parser","kind":"milestone","status":"complete","title":"Parser and logical plan"},{"id":"step-tessera-executor","kind":"milestone","status":"complete","title":"Pull-based executor"},{"id":"step-tessera-optimizer","kind":"milestone","status":"active","title":"Rule-based optimizer"},{"id":"step-tessera-cost","kind":"milestone","status":"planned","title":"Cost-based join ordering"}]},"thematic_group_ids":["thematic-group-data-systems","thematic-group-software"],"title":"Tessera — a toy dataflow query engine","type":"project","unit_ids":["unit-dataframes-lazy-plans"],"workspace_ids":["workspace-tessera-engine"]}]
