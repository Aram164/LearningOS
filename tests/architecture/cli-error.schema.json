{"$id": "learningos/cli-error",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {"error": {"additionalProperties": false,
      "properties": {"code": {"enum": ["INVALID_REQUEST",
            "UNKNOWN_CAPABILITY",
            "STALE_SNAPSHOT",
            "REVISION_CONFLICT",
            "OUT_OF_SCOPE",
            "VALIDATION_FAILED",
            "AMBIGUOUS_MIGRATION",
            "PROJECTION_FAILED",
            "IDEMPOTENCY_CONFLICT",
            "UNCONFIRMED",
            "INTERNAL_FAILURE"]},
        "details": {"additionalProperties": true,
          "properties": {"reason": {"enum": ["NOT_FOUND", "MALFORMED_ID"]},
            "remedy": {"minLength": 1, "type": "string"},
            "suggestions": {"items": {"minLength": 1, "type": "string"},
              "maxItems": 5,
              "type": "array"}},
          "type": "object"},
        "message": {"minLength": 1, "type": "string"},
        "retryable": {"type": "boolean"}},
      "required": ["code", "message", "retryable", "details"],
      "type": "object"}},
  "required": ["error"],
  "type": "object"}
