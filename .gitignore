generated/*
!generated/.gitkeep
# Obsidian (or any app) workspace state is interface-layer, never core (ADR-006).
# /bases/ = installed shelf definitions (owned by obsidian-ui, installed by its
# install.py); /.trash/ = Obsidian's recoverable local trash.
.obsidian/
/bases/
/.trash/
.DS_Store
**/__pycache__/
*.egg-info/
build/
dist/
# Project-local virtual environment (created by `make setup`); never committed —
# it is platform-specific and each contributor builds their own.
.venv/
# AI request/delivery bundles are operational handoff state. Receipts and
# approved canonical artifacts remain tracked.
operations/ai-actions/requests/*
!operations/ai-actions/requests/.gitkeep
operations/ai-actions/deliveries/*
!operations/ai-actions/deliveries/.gitkeep
# Quarantine for untrusted provider output awaiting validation; a leftover
# directory here only ever means an import was interrupted.
operations/ai-actions/incoming/

# Crash-recovery records for an interrupted transaction. They exist only
# between a process dying mid-write and the next run rolling it back, and hold
# copies of canonical files — never a thing to commit.
operations/transactions/.inflight/

# Diagnostic trace store (track #2, Phase 3A). Non-authoritative, disposable,
# bounded operation history: IDs and references only, never payload text.
# Deleting it changes no canonical behavior; the resolver degrades to
# authority-only verdicts. Outside the canonical fingerprint roots.
operations/diagnostics/

# Local-only note attachments: canonical, on disk, backed up, never published.
# Each is pinned by size and SHA-256 in system/contracts/local-attachments.yaml;
# the validator refuses a listed path that Git tracks or that no rule here covers.
/knowledge/attachments/note-sad-descriptive-probability-handwritten/teil-01-part1.pdf
/knowledge/attachments/note-sad-descriptive-probability-handwritten/teil-01-part2.pdf
/knowledge/attachments/note-sad-distributions-handwritten/teil-02-part1.pdf
/knowledge/attachments/note-sad-distributions-handwritten/teil-02-part2.pdf
/knowledge/attachments/note-sad-hypothesis-testing-handwritten/teil-03.pdf
