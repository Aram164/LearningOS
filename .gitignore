generated/*
!generated/.gitkeep
# Obsidian (or any app) workspace state is interface-layer, never core (ADR-006).
# /bases/ = installed shelf definitions (owned by obsidian-ui, installed by its
# install.py); /.trash/ = Obsidian's recoverable local trash.
.obsidian/
/bases/
/.trash/
.DS_Store
**/__pycache__/
*.egg-info/
build/
dist/
# Project-local virtual environment (created by `make setup`); never committed —
# it is platform-specific and each contributor builds their own.
.venv/
# AI request/delivery bundles are operational handoff state. Receipts and
# approved canonical artifacts remain tracked.
operations/ai-actions/requests/*
!operations/ai-actions/requests/.gitkeep
operations/ai-actions/deliveries/*
!operations/ai-actions/deliveries/.gitkeep
# Quarantine for untrusted provider output awaiting validation; a leftover
# directory here only ever means an import was interrupted.
operations/ai-actions/incoming/

# Crash-recovery records for an interrupted transaction. They exist only
# between a process dying mid-write and the next run rolling it back, and hold
# copies of canonical files — never a thing to commit.
operations/transactions/.inflight/
.pytest_cache/
.ruff_cache/
.venv/
